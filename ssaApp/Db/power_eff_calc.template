record(calcout, "$(P)$(R)VCPowCalc")
{
  field(INPA, "$(P)$(R1) CP")
  field(INPB, "$(P)$(R2) CP")
  field(DESC, "$(R) Power Calc")
  field(CALC, "A*B")
  field(FLNK, "$(P)$(R)EffCalc")
}

record(calcout, "$(P)$(R)EffCalc")
{
  field(INPA, "$(P)$(R)VCPowCalc CP")
  field(INPB, "$(P)$(J) CP")
  field(DESC, "Efficiency Calc")
  field(CALC, "A/B")
}
