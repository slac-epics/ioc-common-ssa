    field(INPA, "$(P)3700:SSA:NumOn CP")
    field(INPB, "$(P)3800:SSA:NumOn CP")
    field(INPC, "$(P)3900:SSA:NumOn CP")
    field(INPD, "$(P)4000:SSA:NumOn CP")
